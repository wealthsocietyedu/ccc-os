# ─── Content Command Center OS — Server Config ───────────────────────────────
# Copy this to .env and fill in your values. Never commit .env to git.

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-in-production
# Local dev: any relative path is fine. In production on Railway, this MUST
# point inside the volume's actual mount path (Railway injects it at runtime
# as RAILWAY_VOLUME_MOUNT_PATH) or the DB silently lives on the ephemeral
# filesystem and gets wiped on every redeploy.
DB_PATH=./data/ccc_os.db
CLIENT_URL=http://localhost:5173

# ─── VIDEO DOWNLOADER / CHANNEL DOWNLOADER ────────────────────────────────────
# Path to a Netscape-format cookies.txt file (export via a browser extension like
# "Get cookies.txt"). Without this, yt-dlp cannot fetch age-restricted or
# login-gated YouTube videos, or most Instagram posts.
# YTDLP_COOKIES_FILE=./data/cookies.txt

# Where Channel Downloader writes bulk-archived videos. Same rule as DB_PATH:
# in production this MUST point inside RAILWAY_VOLUME_MOUNT_PATH or archived
# files get wiped on every redeploy. Local dev: any relative path is fine.
# DOWNLOADS_PATH=/data/downloads

# ─── STRIPE ──────────────────────────────────────────────────────────────────
# dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# dashboard.stripe.com/products — create 6 prices, paste IDs below
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_OPERATOR_MONTHLY_PRICE_ID=price_...
STRIPE_OPERATOR_ANNUAL_PRICE_ID=price_...

# ─── PAYPAL ───────────────────────────────────────────────────────────────────
# developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_ENV=sandbox
# developer.paypal.com/dashboard/subscriptions — create 6 plans
PAYPAL_STARTER_MONTHLY_PLAN_ID=P-...
PAYPAL_STARTER_ANNUAL_PLAN_ID=P-...
PAYPAL_PRO_MONTHLY_PLAN_ID=P-...
PAYPAL_PRO_ANNUAL_PLAN_ID=P-...
PAYPAL_OPERATOR_MONTHLY_PLAN_ID=P-...
PAYPAL_OPERATOR_ANNUAL_PLAN_ID=P-...

# ─── AI PROVIDERS ─────────────────────────────────────────────────────────────
# OpenAI — used by Repurpose Engine for AI caption adaptation per platform
# platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: uncomment when building AI Studio features
# ANTHROPIC_API_KEY=sk-ant-...
# ELEVENLABS_API_KEY=xi_...
# RUNWAY_API_KEY=...
# FAL_API_KEY=...

# ─── SCHEDULER — PLATFORM OAUTH ───────────────────────────────────────────────
# YouTube (Google Cloud Console → APIs & Services → OAuth 2.0)
# console.cloud.google.com — enable YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram & Facebook (Meta Developer App — one app covers both + Threads)
# developers.facebook.com/apps
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Threads reuses Instagram/Meta credentials — no extra vars needed

# LinkedIn (LinkedIn Developer Portal)
# developer.linkedin.com/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok (TikTok for Developers)
# developers.tiktok.com — create app, enable Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X / Twitter (Twitter Developer Portal — requires Basic tier ~$100/mo)
# developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Pinterest (Pinterest Developer Platform)
# developers.pinterest.com/apps
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ─── ADMIN ACCESS ─────────────────────────────────────────────────────────────
# Email that auto-gets admin on registration (your email)
ADMIN_EMAIL=you@youremail.com

# Secret header for the /api/auth/make-admin endpoint
ADMIN_SECRET=change-this-to-something-long-and-random

# Set to 'true' to bypass ALL billing checks for ALL users (dev/testing only)
# Remove or set to 'false' before going live
BYPASS_BILLING=false
